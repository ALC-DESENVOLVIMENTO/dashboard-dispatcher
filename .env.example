NODE_ENV=production
PORT=4173
DATABASE_URL=postgresql://app_user:example_password@db.example.internal:5432/bonus_control
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_RUN_MIGRATIONS=false
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
APP_ORIGIN=https://dashboard.example.com
TRUST_PROXY=false
ADMIN_MUTATIONS_ENABLED=true
ADMIN_READ_ENABLED=true
ADMIN_IP_ALLOWLIST=*
AUTH_USERNAME=gerencia
AUTH_PASSWORD_HASH=scrypt$16384$8$1$706468c7d5d3623149f36c0b08e78dba$7ac2d8d1f827f2fc57c0bf3c85b31633d0d68be617b92845c30a60d4fec5a45d3113d7f776e4752892aa024759abe0f06c0f198b0ece50d2ad8514c2ae84d1c6
AUTH_COORDINATION_USERNAME=coordenacao
AUTH_COORDINATION_PASSWORD_HASH=scrypt$N$r$p$example_salt$example_hash
AUTH_DISPATCHER_USERNAME=dispatcher
AUTH_DISPATCHER_PASSWORD_HASH=scrypt$N$r$p$example_salt$example_hash
AUTH_SESSION_TTL_SECONDS=28800
AUTH_RATE_LIMIT_PER_15_MIN=120
